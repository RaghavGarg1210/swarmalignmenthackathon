# Configure only on the operator's host. Never give these credentials to agents.
ADAPTION_API_KEY=replace_with_your_private_key
ADAPTION_BASE_URL=https://api.prod.adaptionlabs.ai/api/v1
# Optional human-operator SMTP alerts (configure on host only):
# BENCH_OPERATOR_EMAIL=your-operator@example.org
# BENCH_SMTP_HOST=smtp.example.org
# BENCH_SMTP_PORT=587
# BENCH_FROM_EMAIL=bench@your-domain.example
# BENCH_SMTP_USER=...
# BENCH_SMTP_PASSWORD=...
