# Copy to .env and fill in. Inspect's OpenAI provider is pointed at Adaption.
OPENAI_API_KEY=your-adaption-api-key
OPENAI_BASE_URL=https://api.prod.adaptionlabs.ai/api/v1
# Required by Inspect's Cybench loader when using docker sandboxes.
CYBENCH_ACKNOWLEDGE_RISKS=1
# Keep Inspect logs as .eval files under results/
INSPECT_LOG_FORMAT=eval
